# ===========================
# GoHighLevel App (Marketplace)
# ===========================
GHL_CLIENT_ID=6927146f81129e5d3362bf17-mmf4qj9b
GHL_CLIENT_SECRET=5d5c051e-3f0b-41b0-8a41-ac1993092c39
GHL_REDIRECT_URI=https://seu-servidor.com/oauth/callback

# Conversation Provider ID (do app Axen WP)
GHL_CONVERSATION_PROVIDER_ID=your-provider-id-here

# ===========================
# Banco de Dados
# ===========================
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ===========================
# Servidor
# ===========================
HOST=0.0.0.0
PORT=8000

# ===========================
# Segurança
# ===========================
# Senha do painel admin — OBRIGATORIA em producao (sem ela o app nao inicia)
ADMIN_PASSWORD=sua-senha-forte-aqui

# Origens permitidas para CORS (separadas por virgula)
# Em DEBUG=true, se vazio permite tudo. Em producao, deve ser configurado.
ALLOWED_ORIGINS=https://seudominio.com

# Token secreto para validar webhooks do Z-API (opcional, mas recomendado)
ZAPI_WEBHOOK_SECRET=um-token-secreto-qualquer

# Modo debug (true = hot reload, CORS permissivo, senha fallback)
DEBUG=false

# ===========================
# Logs
# ===========================
LOG_LEVEL=INFO

# --- Tetos da entrevista da IA Mestre (link publico e ANONIMO) ---
# `0` ou ausente = SEM LIMITE, que e o padrao hoje. Definir aqui (ou, no futuro,
# pelo painel admin) liga o teto correspondente.
# Lembre que a rota gasta a NOSSA chave Anthropic; o unico freio que continua de
# pe com tudo em 0 e o rate limit de 20/min por IP.
ENTREVISTA_MAX_TURNOS=0
ENTREVISTA_MAX_TOKENS_SAIDA=0
ENTREVISTA_MAX_PESQUISAS=0
ENTREVISTA_MAX_BUSCAS_WEB=0
# Este e por CHAMADA (quantas buscas enquanto responde UMA mensagem), nao por
# entrevista — impede laco de busca dentro de um turno. Padrao 3.
ENTREVISTA_MAX_USOS_BUSCA=3
